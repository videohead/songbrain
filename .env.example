# Any OpenAI-compatible chat completions endpoint works.
# OpenAI:      https://api.openai.com/v1
# Ollama:      http://host.docker.internal:11434/v1   (LLM_API_KEY can be anything)
# NVIDIA NIM:  https://integrate.api.nvidia.com/v1
# LiteLLM:     http://host.docker.internal:4000/v1  (LiteLLM proxy running on the host; key = its master/virtual key)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
PORT=5173
